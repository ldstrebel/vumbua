        "blocks": [
          {
            "title": "The Feral Resonance",
            "type": "header"
          },
          {
            "content": "A Node is humming in a dissonant B-Minor. Standard protocol dictates a C-Major Pulse. However, the Node is 'weeping' Spores—it is alive. A C-Major Pulse will kill it.",
            "type": "text"
          },
          {
            "revealLabel": "Secret Insight (Aggie)",
            "condition": {
              "requiredScore": "AGGIE"
            },
            "type": "secret",
            "content": "In the Petrified Forest, you learned that life doesn't want to be 'corrected', it wants to be heard. Matching the spores' frequency isn't just a choice; it's a conversation."
          }
        ]
      }
