          {
            "condition": {
              "requiredScore": "BRITT"
            },
            "revealLabel": "Secret Insight (Britt)",
            "type": "secret",
            "content": "As a roof-runner, you know that trying to fight the wind when you're already at your limit just leads to a wipeout. Momentum is your friend—sometimes you have to let go to get where you're going."
          }
        ],
        "ports": [
